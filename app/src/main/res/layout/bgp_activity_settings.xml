<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgp_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/settings_back"
            style="@style/BgpIconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/bgp_close"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/bgp_settings"
            android:textColor="@color/bgp_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/bgp_section_playback"
                android:textAllCaps="true"
                android:textColor="@color/bgp_text_tertiary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Background play -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bgp_bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BgpTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bgp_background_play" />

                    <TextView
                        style="@style/BgpMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:text="@string/bgp_background_play_summary" />
                </LinearLayout>

                <com.via.bgplay.widget.PillSwitch
                    android:id="@+id/switch_background_play"
                    android:layout_width="46dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Rich media notification -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bgp_bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BgpTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bgp_media_notification" />

                    <TextView
                        style="@style/BgpMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:text="@string/bgp_media_notification_summary" />
                </LinearLayout>

                <com.via.bgplay.widget.PillSwitch
                    android:id="@+id/switch_media_notification"
                    android:layout_width="46dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- System media controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bgp_bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BgpTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bgp_media_session" />

                    <TextView
                        style="@style/BgpMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:text="@string/bgp_media_session_summary" />
                </LinearLayout>

                <com.via.bgplay.widget.PillSwitch
                    android:id="@+id/switch_media_session"
                    android:layout_width="46dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Mute hidden videos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bgp_bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BgpTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bgp_mute_hidden" />

                    <TextView
                        style="@style/BgpMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:text="@string/bgp_mute_hidden_summary" />
                </LinearLayout>

                <com.via.bgplay.widget.PillSwitch
                    android:id="@+id/switch_mute_hidden"
                    android:layout_width="46dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Wake lock -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bgp_bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BgpTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bgp_wake_lock" />

                    <TextView
                        style="@style/BgpMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:text="@string/bgp_wake_lock_summary" />
                </LinearLayout>

                <com.via.bgplay.widget.PillSwitch
                    android:id="@+id/switch_wake_lock"
                    android:layout_width="46dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/bgp_section_system"
                android:textAllCaps="true"
                android:textColor="@color/bgp_text_tertiary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Notification permission -->
            <LinearLayout
                android:id="@+id/row_notification_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BgpTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bgp_notification_permission" />

                    <TextView
                        android:id="@+id/text_notification_permission"
                        style="@style/BgpMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/bgp_notification_permission_summary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/notification_permission_state"
                    style="@style/BgpMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    tools:text="Granted" />
            </LinearLayout>

            <!-- Battery optimisation -->
            <LinearLayout
                android:id="@+id/row_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BgpTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bgp_battery_optimization" />

                    <TextView
                        android:id="@+id/text_battery"
                        style="@style/BgpMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="3"
                        android:text="@string/bgp_battery_optimization_summary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/battery_state"
                    style="@style/BgpMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    tools:text="On" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/bgp_section_about"
                android:textAllCaps="true"
                android:textColor="@color/bgp_text_tertiary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/about_version"
                style="@style/BgpMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="5"
                tools:text="Version 1.0.0" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
