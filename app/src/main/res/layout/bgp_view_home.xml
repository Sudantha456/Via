<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgp_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/bgp_app_name"
            android:textColor="@color/bgp_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/bgp_home_subtitle"
            android:textColor="@color/bgp_text_secondary"
            android:textSize="13sp" />

        <!-- Background play status card -->
        <LinearLayout
            android:id="@+id/home_bg_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bgp_bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/bgp_background_play"
                android:src="@drawable/ic_headphones"
                android:tint="@color/bgp_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/home_bg_title"
                    style="@style/BgpTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Background play is on" />

                <TextView
                    android:id="@+id/home_bg_summary"
                    style="@style/BgpMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    tools:text="Audio keeps playing with the screen off" />
            </LinearLayout>

            <com.via.bgplay.widget.PillSwitch
                android:id="@+id/home_bg_switch"
                android:layout_width="46dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Quick shortcuts -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/bgp_quick_links"
            android:textAllCaps="true"
            android:textColor="@color/bgp_text_tertiary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/home_shortcut_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- Recent tabs -->
        <TextView
            android:id="@+id/home_recent_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/bgp_recent"
            android:textAllCaps="true"
            android:textColor="@color/bgp_text_tertiary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/home_recent_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
