<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ViaBg" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bgp_accent</item>
        <item name="colorPrimaryDark">@color/bgp_surface</item>
        <item name="colorAccent">@color/bgp_accent</item>
        <item name="android:windowBackground">@color/bgp_surface</item>
        <item name="android:statusBarColor">@color/bgp_surface</item>
        <item name="android:navigationBarColor">@color/bgp_surface</item>
        <item name="android:textColorPrimary">@color/bgp_text_primary</item>
        <item name="android:textColorSecondary">@color/bgp_text_secondary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="Theme.ViaBg.Settings" parent="Theme.ViaBg">
        <item name="android:windowBackground">@color/bgp_surface</item>
    </style>

    <style name="Bgp.Text.Title">
        <item name="android:textSize">@dimen/bgp_text_title</item>
        <item name="android:textColor">@color/bgp_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Bgp.Text.Meta">
        <item name="android:textSize">@dimen/bgp_text_meta</item>
        <item name="android:textColor">@color/bgp_text_secondary</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Bgp.IconButton">
        <item name="android:layout_width">@dimen/bgp_touch</item>
        <item name="android:layout_height">@dimen/bgp_touch</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">10dp</item>
        <item name="tint">@color/bgp_text_primary</item>
    </style>

    <style name="Bgp.Switch">
        <item name="android:thumbTint">@color/bgp_accent</item>
        <item name="android:trackTint">@color/bgp_accent_dim</item>
    </style>
</resources>
